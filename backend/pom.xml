<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Multi-module Maven layout. Sprint 8 migration documented in
      specs_archives/specs_claude/specs_microservices_migration.md
      (decision 4). After step 15 (PR 14 of the roadmap), the legacy
      Quarkus monolith is gone — every reactor module is a Quarkus
      microservice owning a bounded-context endpoint group.

      `cd backend && ./mvnw verify` builds every <module> declared below
      with the same Quarkus chain ; each service POMs its own image name
      via application.properties.
    -->

    <groupId>ch.unige.events</groupId>
    <artifactId>parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>UNIGE Events — backend parent</name>

    <modules>
        <!-- Shared libs (jar packaging, hors `services/*-service/` glob
             d'exclusion Sonar — leur couverture est comptée). -->
        <module>services/shared-rate-limit</module>
        <module>services/shared-storage</module>
        <module>services/shared-api-error</module>
        <module>services/shared-domain-enums</module>
        <module>services/shared-jaxrs</module>
        <module>services/shared-tracing</module>
        <module>services/shared-kafka-events</module>
        <module>services/shared-platform</module>
        <module>services/shared-domain-dtos</module>
        <module>services/shared-domain-projections</module>

        <!-- Microservices Quarkus extraits — un par bounded context. -->
        <module>services/user-service</module>
        <module>services/event-service</module>
        <module>services/engagement-service</module>
        <module>services/comment-service</module>
        <module>services/moderation-service</module>
        <module>services/calendar-service</module>
        <module>services/notification-service</module>
    </modules>

    <properties>
        <quarkus.amazon.version>3.18.0</quarkus.amazon.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.35.1</quarkus.platform.version>
        <!-- Pinned to match the smallrye-reactive-messaging version that
             ships with quarkus-bom 3.35.1. Used by the in-memory test
             connector swap declared in <dependencyManagement>. -->
        <smallrye-reactive-messaging.version>4.34.0</smallrye-reactive-messaging.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.5</surefire-plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar.organization>unige-pinfo6-2026</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.projectKey>unige-pinfo6-2026_unige-events-backend</sonar.projectKey>
        <sonar.projectName>unige-events-backend</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/jacoco-report/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!--
          Historical note (HYGIENE-005 / SPEC-019 closed): the Sonar
          coverage + CPD exclusions on services/*-service/** were
          removed in the completion étape 12. They were in place during
          the soft-extraction phase to mask duplicated code that lived
          simultaneously in legacy-monolith and in the scaffolds. With
          legacy-monolith removed (commit b570c1b) and the per-service
          tests being ported (étape 7 of the completion spec), the
          glob would now mask real coverage gaps instead of duplication.
        -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.amazonservices</groupId>
                <artifactId>quarkus-amazon-services-bom</artifactId>
                <version>${quarkus.amazon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              Test-only Kafka in-memory connector swap. Pinned here so
              producer/consumer services don't have to repeat the version
              + scope (KAFKA-009 of the completion spec). The version is
              kept in sync with the smallrye-reactive-messaging artifacts
              shipped by quarkus-bom 3.35.1.
            -->
            <dependency>
                <groupId>io.smallrye.reactive</groupId>
                <artifactId>smallrye-reactive-messaging-in-memory</artifactId>
                <version>${smallrye-reactive-messaging.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <extensions>true</extensions>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine} -Djava.security.egd=file:/dev/./urandom</argLine>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                        <systemPropertyVariables>
                            <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
