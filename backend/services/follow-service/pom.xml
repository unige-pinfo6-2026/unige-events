<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.unige.events</groupId>
        <artifactId>parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!--
      follow-service — Quarkus skeleton scaffolded by step 2..14 of the migration
      (cf. specs_archives/specs_claude/specs_microservices_migration.md
      decision 4). jar-packaging on purpose: keeps the parent reactor build
      fast (no Quarkus AOT, no container-image push), avoids any clash
      with legacy-monolith's image name, but still lets @QuarkusTest
      tests run because the Quarkus runtime classes are on classpath.
      The follow-up extraction PR will:
        1. switch <packaging> to quarkus,
        2. add the missing extensions (jdbc-postgresql, hibernate-orm-panache,
           flyway, rest-client-reactive, smallrye-reactive-messaging-kafka,
           smallrye-fault-tolerance, micrometer-registry-prometheus),
        3. add quarkus-container-image-jib + override container-image-name,
        4. flip the matching Kong route from api:8080 to follow-service:8080,
        5. carve resources / services / entities out of services/legacy-monolith/.
    -->

    <artifactId>follow-service</artifactId>
    <packaging>jar</packaging>
    <name>UNIGE Events — follow-service</name>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
