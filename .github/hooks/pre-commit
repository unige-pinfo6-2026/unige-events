#!/bin/bash
# Hook pre-commit — vérifie la cohérence documentation et les conventions

CHANGED=$(git diff --cached --name-only)

needs_doc_update=false
message=""

# Vérifie les booléens préfixés `is` dans les entités Java (convention interdite)
entity_files=$(echo "$CHANGED" | grep -E "src/main/java/.+/entity/.+\.java$")
if [ -n "$entity_files" ]; then
  for f in $entity_files; do
    if git show ":$f" 2>/dev/null | grep -qE "boolean\s+is[A-Z]"; then
      echo ""
      echo "  ✗ Champ booléen préfixé 'is' détecté dans $f"
      echo "  Utilise 'active' au lieu de 'isActive', 'featured' au lieu de 'isFeatured', etc."
      echo "  (Lombok génèrerait isIsActive() — conflit garanti. Jackson sérialise mal.)"
      exit 1
    fi
  done
fi

if echo "$CHANGED" | grep -qE "src/main/java/.+/(entity|resource)/.+\.java$"; then
  needs_doc_update=true
  message="${message}\n  ⚠️  Entité ou Resource modifiée — vérifier docs/openapi/openapi.yaml et docs/data-model.md"
fi


if echo "$CHANGED" | grep -qE "docs/openapi/openapi\.yaml$"; then
  if ! echo "$CHANGED" | grep -qE "src/main/java/.+/resource/.+\.java$"; then
    echo "  ℹ️  openapi.yaml modifié sans Resource correspondante — normal si spec-first ✓"
  fi
fi

if [ "$needs_doc_update" = true ]; then
  echo ""
  echo "📚 Documentation à vérifier dans ce commit :"
  echo -e "$message"
  echo ""

  doc_files_in_commit=$(echo "$CHANGED" | grep -cE "^docs/")
  if [ "$doc_files_in_commit" -eq 0 ]; then
    echo "  ✗ Aucun fichier docs/ dans ce commit alors que du code critique a changé."
    echo "  Mets à jour la documentation ou utilise --no-verify pour forcer."
    exit 1
  else
    echo "  ✓ Fichiers docs/ détectés dans le commit — merci !"
  fi
fi

exit 0
