# Auth0
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-api-audience
# Doit refléter la même URL que `OIDC_ROLE_NAMESPACE` côté backend (clé portant
# les rôles dans le JWT Auth0). Default aligné sur application.properties.
VITE_AUTH0_ROLES_CLAIM=https://unige-events/roles